<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>Document</title>
</head>

<body>

    <head>
        <title>SunSetSolar - Registration</title>

    <body>
        <div class="container">
            <h1>Sun Son Solar</h1>
            <p class="subtitle">Create your account</p>

            <form action="#" method="POST">

                First Name:
                <input type="text" id="Firstname" name="Firstname" placeholder="Enter your first name" required><br><br>
                Last Name:
                <input type="text" id="Lastname" name="Lastname" placeholder="Enter your last name" required><br><br>
                Middlename:
                <input type="text" id="Middlename" name="Middlename" placeholder="Enter your middle name" required><br><br>
                Birthdate:
                <input id="birthdate" name="birthdate" type="date" required><br><br>
                <div class="gender-box">
                    Gender:
                    <input type="radio" name="gender" value="male" required> Male
                    <input type="radio" name="gender" value="female"> Female
                    <input type="radio" name="gender" value="other"> Other
                </div><br><br>
                Email address:
                <input type="email" id="email" name="email" placeholder="Enter your email" required><br><br>
                Number:
                <input type="number" id="phone" name="phone" placeholder="09*******" pattern="[0-9]{11}" maxlength="11"
                    required> <br><br>
                <select id="userType" name="userType" required>
                    <option value=""> Select User Type </option>
                    <option value="customer">Customer</option>
                    <option value="employee">Employee</option>
                    <option value="admin">Administrator</option>
                </select><br><BR>
                Address:
                <input type="text" id="address" name="address" placeholder="Enter your address" required><br><br>
                Username:
                <input type="text" id="username" name="username" placeholder="Enter your username" required><br><br>
                Password:
                <input type="password" id="password" name="password" placeholder="Enter your password" required
                    minlength="8"><br><br>
                Confirm Password:
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm your password"
                    required minlength="13"><BR><BR>

                <button type="submit" class="register-btn">
                    Register
                </button>

            </form>

            <p class="login">
                Already have an account?
                <a href="#">Login</a>
            </p>

        </div>

    </body>

</html>
</body>

</html>
